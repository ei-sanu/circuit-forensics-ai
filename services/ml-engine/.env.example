# ==========================================
# ML Engine Microservice Configuration
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development
LOG_LEVEL=INFO

# Service-to-Service Security
INTERNAL_SERVICE_SECRET=replace-with-secure-internal-service-key

# Local AI / LLM Configuration
# Options: "none" (deterministic rule-based offline mode), "local" (Ollama / vLLM / llama.cpp), "openai"
LLM_PROVIDER=none
LOCAL_LLM_URL=http://localhost:11434/v1
MODEL_NAME=llama3.2
OPENAI_API_KEY=
