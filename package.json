{
  "name": "circuit",
  "version": "1.0.0",
  "description": "CIRCUIT — Criminal Intelligence & Relationship Investigation using Connected-Entity Tracking",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-all.js",
    "dev:frontend": "next dev -p 8080",
    "dev:all": "node scripts/dev-all.js",
    "clean:ports": "node scripts/clean-ports.js",
    "build": "next build",
    "start": "next start -p 8080",
    "lint": "next lint",
    "server": "node scripts/run-server.js",
    "server:install": "node scripts/install-server.js",
    "server:test": "node scripts/test-server.js",
    "ml:test": "node scripts/test-ml.js",
    "test:all": "npm run server:test && npm run ml:test",
    "ml": "node scripts/run-ml.js",
    "ml:install": "node scripts/install-ml.js",
    "setup": "node scripts/install-all.js",
    "install:all": "node scripts/install-all.js",
    "model:setup": "bash scripts/setup_local_model.sh",
    "model:status": "curl -s http://localhost:3000/api/copilot/model-status",
    "train:local": "python3 scripts/train_local.py"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "clsx": "^2.1.1",
    "cytoscape": "^3.30.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.462.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2"
  }
}
