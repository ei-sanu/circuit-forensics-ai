# ============================================================
# CIRCUIT Configuration Template (.env.example)
# Copy this file to .env or server/.env and fill in your values
# ============================================================

PORT=3000
NODE_ENV=development
APP_NAME="CIRCUIT Intelligence Server"

# ------------------------------------------------------------
# Database Connection (Supabase Cloud or Local PostgreSQL)
# ------------------------------------------------------------
# For Supabase Pooler:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For Local Docker PostgreSQL:
DATABASE_URL=postgresql+asyncpg://circuit:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/circuit_db

# Supabase API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------
# Security & Biometrics
# ------------------------------------------------------------
JWT_SECRET=replace-with-a-32-byte-random-high-entropy-secret
JWT_EXPIRES_IN=1h
JWT_EXPIRES_SECONDS=3600
BIOMETRIC_ENCRYPTION_KEY=replace-with-a-32-byte-hex-encryption-key
BIOMETRIC_ENABLED=true
SEED_DEFAULT_PASSWORD=replace-with-secure-initial-admin-password

# ------------------------------------------------------------
# CORS Configuration (Explicit trusted origins only)
# ------------------------------------------------------------
CORS_ORIGIN=http://localhost:8080,http://localhost:3000
